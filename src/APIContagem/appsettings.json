{
  "SimularFalhas": "true",
  "Saudacao": "Testes com Native OpenTelemetry Tracing no .NET 11",
  "OtlpExporter": {
    "Endpoint": "http://localhost:4317"
  },
  "OTEL_SERVICE_NAME": "apicontagem-dotnet11",
  "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=DEV",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
